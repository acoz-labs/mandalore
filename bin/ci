#!/usr/bin/env bash
set -euo pipefail

bin/validate-solution-plans

for script in bin/*; do
  [[ -f "$script" ]] || continue
  if head -n 1 "$script" | grep -q 'bash'; then
    bash -n "$script"
  fi
done

for document in README.md AGENTS.md LICENSE SECURITY.md CONTRIBUTING.md \
  docs/product.md docs/architecture.md docs/migration.md docs/roadmap.md \
  docs/development.md docs/deployment.md docs/runbook.md; do
  [[ -s "$document" ]] || { echo "Missing required document: $document" >&2; exit 1; }
done

git diff --check
git diff --cached --check

# Heuristic safeguard only: review remains necessary before public publication.
if git grep -I -l -E 'BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY|github_pat_[A-Za-z0-9_]{20,}|gh[pousr]_[A-Za-z0-9]{30,}|/(Users|home)/[[:alnum:]][[:alnum:]_.-]*/' -- . ':!bin/ci'; then
  echo "Potential private credential or workstation path; inspect listed files before publishing." >&2
  exit 1
else
  scan_status=$?
  [[ "$scan_status" == "1" ]] || { echo "Public-content scan failed." >&2; exit "$scan_status"; }
fi

for workflow in .github/workflows/*.yml; do
  if grep 'runs-on:' "$workflow" | grep -v -F '[self-hosted, trusted-linux-x64]'; then
    echo "Optional workflows must use trusted self-hosted runners: $workflow" >&2
    exit 1
  fi
done

[[ "$(go env GOVERSION)" == "go1.26.4" ]] || {
  echo "Go 1.26.4 is required; use mise exec go@1.26.4 -- bin/ci." >&2
  exit 1
}
[[ -z "$(gofmt -l internal cmd)" ]] || { echo "Run gofmt on internal/ and cmd/." >&2; exit 1; }
[[ "$(node --version)" == "v24.1.0" ]] || {
  echo "Node 24.1.0 is required for Pi adapter tests; use mise exec -- bin/ci." >&2
  exit 1
}
node --test plugins/pi/test/*.test.mjs
go mod verify
git --version
go test -race ./...
go vet ./...
for target_os in darwin linux; do
  for target_arch in amd64 arm64; do
    GOOS="$target_os" GOARCH="$target_arch" CGO_ENABLED=0 go build ./...
  done
done

echo "Engine/interface checks and target builds passed; cross-builds are not native acceptance."
