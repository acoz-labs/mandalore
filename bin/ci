#!/usr/bin/env bash
set -euo pipefail

bin/validate-solution-plans

for script in bin/*; do
  [[ -f "$script" ]] || continue
  if head -n 1 "$script" | grep -q 'bash'; then
    bash -n "$script"
  fi
done

for document in README.md AGENTS.md LICENSE SECURITY.md CONTRIBUTING.md \
  docs/product.md docs/architecture.md docs/migration.md docs/roadmap.md \
  docs/development.md docs/deployment.md docs/runbook.md; do
  [[ -s "$document" ]] || { echo "Missing required document: $document" >&2; exit 1; }
done

git diff --check
git diff --cached --check

# Heuristic safeguard only: review remains necessary before public publication.
if git grep -I -l -E 'BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY|github_pat_[A-Za-z0-9_]{20,}|gh[pousr]_[A-Za-z0-9]{30,}|/(Users|home)/[[:alnum:]][[:alnum:]_.-]*/' -- . ':!bin/ci'; then
  echo "Potential private credential or workstation path; inspect listed files before publishing." >&2
  exit 1
else
  scan_status=$?
  [[ "$scan_status" == "1" ]] || { echo "Public-content scan failed." >&2; exit "$scan_status"; }
fi

# Deployment-facing docs and packaging name only placeholder or public service
# hosts and addresses, never a real deployment's. A last label that is also a
# file extension (md, sh, go, py, js, ts, mjs) is not treated as a host.
deploy_files=(README.md docs/server.md docs/deploy packaging/server bin/publish-server-image)
deploy_hosts=$(git grep -I -h -o -E '([A-Za-z0-9-]+\.)+[A-Za-z][A-Za-z0-9-]*' -- "${deploy_files[@]}" | sort -u |
  grep -i -x -E '.*\.(com|net|org|io|dev|app|cloud|ai|me|xyz|lan|internal|local|localdomain|home|arpa|corp|[a-z]{2})' |
  grep -i -v -x -E '.*\.(md|sh|go|py|js|ts|mjs)|([a-z0-9-]+\.)?example\.(com|net|org)|github\.com|ghcr\.io|claude\.ai' || true)
deploy_addresses=$(git grep -I -h -o -E '[0-9]{1,3}(\.[0-9]{1,3}){3}' -- "${deploy_files[@]}" | sort -u |
  grep -v -x -E '127\.0\.0\.1|0\.0\.0\.0|160\.79\.104\.0|(192\.0\.2|198\.51\.100|203\.0\.113)\.[0-9]+' || true)
[[ -z "$deploy_hosts$deploy_addresses" ]] || {
  echo "Unexpected hosts or addresses in deployment docs or packaging: $deploy_hosts $deploy_addresses" >&2
  exit 1
}

for workflow in .github/workflows/*.yml; do
  if grep 'runs-on:' "$workflow" | grep -v -F '[self-hosted, trusted-linux-x64]'; then
    echo "Optional workflows must use trusted self-hosted runners: $workflow" >&2
    exit 1
  fi
done

[[ "$(go env GOVERSION)" == "go1.26.4" ]] || {
  echo "Go 1.26.4 is required; use mise exec go@1.26.4 -- bin/ci." >&2
  exit 1
}
[[ -z "$(gofmt -l internal cmd)" ]] || { echo "Run gofmt on internal/ and cmd/." >&2; exit 1; }
[[ "$(node --version)" == "v24.1.0" ]] || {
  echo "Node 24.1.0 is required for Pi adapter tests; use mise exec -- bin/ci." >&2
  exit 1
}
# connection.test.mjs drives the 1.x stdio/session runtime that 2.0 removed
# (#167); the Pi plugin and this step leave the build in #163.
node --test $(ls plugins/pi/test/*.test.mjs | grep -v '/connection\.test\.mjs$')
python3 -B -m unittest discover -s plugins/hermes/test -v
go mod verify
git --version
go test -race ./...
# The race detector slows memory_context several times over; on a plain build
# assert criterion 7's 300 ms warm-path p95 and the 1 s post-write tripwire.
go test -count=1 -run '^TestMemoryContext(LatencyOnLargeSignet|AfterWriteLatency)$' ./internal/server/
go vet ./...
for target_os in darwin linux; do
  for target_arch in amd64 arm64; do
    GOOS="$target_os" GOARCH="$target_arch" CGO_ENABLED=0 go build ./...
  done
done

echo "Engine/interface checks and target builds passed; cross-builds are not native acceptance."
