#!/usr/bin/env bash
# Publish ghcr.io/acoz-labs/mandalore:VERSION from an accepted local candidate.
# The image carries the candidate's own linux/amd64 and linux/arm64 binaries,
# verified first; nothing is rebuilt from source. Prints the pushed digest for
# the release record.
#
# Usage: mise exec -- bin/publish-server-image --directory DIR --identity PRODUCT_IDENTITY
# In GitHub Actions it logs in to ghcr.io as GITHUB_ACTOR with the workflow's
# GITHUB_TOKEN (packages: write), in a temporary Docker config removed on exit.
# Without those variables it uses the caller's existing Docker login.
set -euo pipefail
usage='Usage: mise exec -- bin/publish-server-image --directory DIR --identity PRODUCT_IDENTITY'
[[ "$#" == 4 && "$1" == --directory && "$3" == --identity ]] || { echo "$usage" >&2; exit 2; }
directory=$2 identity=$3

bin/promote-local-candidate --verify-only --directory "$directory" --identity "$identity"
read -r version commit < <(python3 -c 'import json,sys; m=json.load(open(sys.argv[1])); print(m["version"], m["source_commit"])' "$directory/manifest.json")
[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+([-+][0-9A-Za-z.+-]+)?$ && "$commit" =~ ^[0-9a-f]{40}$ ]] || { echo "Unexpected manifest version or source commit." >&2; exit 1; }

stage=$(mktemp -d "${TMPDIR:-/tmp}/mandalore-image.XXXXXXXX")
builder=mandalore-publish-$$
cleanup() { docker buildx rm "$builder" >/dev/null 2>&1 || true; rm -rf "$stage"; }
trap cleanup EXIT

mkdir -p "$stage/build/out"
for arch in amd64 arm64; do
  install -m 0755 "$directory/mandalore_${version}_linux_${arch}" "$stage/build/out/mandalore-linux-$arch"
done
if [[ -n "${GITHUB_TOKEN:-}" && -n "${GITHUB_ACTOR:-}" ]]; then
  export DOCKER_CONFIG="$stage/docker"
  mkdir -p "$DOCKER_CONFIG"
  printf '%s' "$GITHUB_TOKEN" | docker login ghcr.io --username "$GITHUB_ACTOR" --password-stdin >/dev/null
fi
if docker buildx imagetools inspect "ghcr.io/acoz-labs/mandalore:$version" >/dev/null 2>&1; then
  echo "ghcr.io/acoz-labs/mandalore:$version already exists; a published tag is never moved." >&2
  exit 1
fi
docker buildx create --name "$builder" --driver docker-container >/dev/null
docker buildx build --builder "$builder" --platform linux/amd64,linux/arm64 \
  --build-context build="$stage/build" -f packaging/server/Dockerfile \
  --label org.opencontainers.image.source=https://github.com/acoz-labs/mandalore \
  --label org.opencontainers.image.version="$version" \
  --label org.opencontainers.image.revision="$commit" \
  --tag "ghcr.io/acoz-labs/mandalore:$version" --metadata-file "$stage/metadata.json" --push .
digest=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["containerimage.digest"])' "$stage/metadata.json")
echo "ghcr.io/acoz-labs/mandalore:$version@$digest"
